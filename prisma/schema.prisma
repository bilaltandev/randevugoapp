datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  name       String
  phone      String?
  role       String     @default("BUSINESS_OWNER") // "BUSINESS_OWNER" | "TEAM_MEMBER" | "ADMIN" | "SUPER_ADMIN" | "SUPPORT"
  isActive   Boolean    @default(true) // Support agents can be deactivated by a super admin
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
  mobileSessions MobileSession[]
  employee   Employee?  // TEAM_MEMBER: the staff record this account works as
}

model Business {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  slug            String         @unique
  sector          String         @default("BERBER") // "BERBER" | "GUZELLIK" | "RESTORAN" | "KLINIK" | "OTO_SERVIS" | "DIGER"
  description     String?
  logo            String?
  coverImage      String?
  phone           String
  address         String
  city            String         @default("İstanbul")
  whatsappNumber  String?
  isVerified      Boolean        @default(true)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  themeId              String?        @default("premium-dark")
  enableStaffSelection Boolean        @default(true)

  services        Service[]
  employees       Employee[]
  customers       Customer[]
  appointments    Appointment[]
  workingHours    WorkingHour[]
  page            Page?
  reviews         Review[]
  subscription    Subscription?
  notifications   Notification[]
  gallery         Gallery?
  galleryItems    GalleryItem[]
  restaurantAreas RestaurantArea[]
  restaurantTables RestaurantTable[]
  supportTickets  SupportTicket[]
  couponRedemptions CouponRedemption[]
  teamInvites     TeamInvite[]
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  sector   String
  icon     String?
  services Service[]
}

model Service {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  durationMinutes Int               @default(30)
  price           Float             @default(0)
  image           String?
  isActive        Boolean           @default(true)
  sectorDetails   String?           // JSON for sector specific data (e.g. capacity, brand)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  employeeServices EmployeeService[]
  appointments     Appointment[]
}

model Employee {
  id          String            @id @default(uuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  photo       String?
  specialty   String
  phone       String?
  email       String?
  isActive    Boolean           @default(true)
  userId      String?           @unique // TEAM plan: the member account that accepted this record's invite
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  employeeServices EmployeeService[]
  teamInvites      TeamInvite[]
  appointments     Appointment[]
  workingHours     WorkingHour[]
  reviews          Review[]
}

model EmployeeService {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
}

model Customer {
  id                String        @id @default(uuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  email             String?
  notes             String?
  totalAppointments Int           @default(0)
  totalSpent        Float         @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  appointments      Appointment[]
  reviews           Review[]
}

model Appointment {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  
  date          String    // YYYY-MM-DD
  startTime     String    // HH:mm
  endTime       String    // HH:mm
  status        String    @default("PENDING") // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED"
  
  customerName  String
  customerPhone String
  customerEmail String?
  notes         String?
  price         Float     @default(0)
  sectorData    String?   // JSON for sector details (plate number, guest count, etc.)
  isBlockedSlot Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  review        Review?
}

model WorkingHour {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek      Int       // 0: Pazar, 1: Pazartesi, ..., 6: Cumartesi
  isOpen         Boolean   @default(true)
  openTime       String    @default("09:00")
  closeTime      String    @default("19:00")
  breakStartTime String?   @default("13:00")
  breakEndTime   String?   @default("14:00")
}

model Page {
  id             String   @id @default(uuid())
  businessId     String   @unique
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  blocksJson     String   // Array of blocks in JSON: Hero, About, Services, Staff, Gallery, Reviews, Location, Booking, Contact
  themeColor     String   @default("indigo")
  font           String   @default("Inter")
  themeId        String?  @default("premium-dark")
  themeOverrides String?  // JSON for overrides: primaryColor, heroLayout, customStyle
  sectionOrder   String?  // JSON array for section order e.g. ["Hero", "Services", "Staff", "Reviews", "Booking", "Location"]
  hiddenSections String?  // JSON array for hidden section types e.g. ["Gallery"]
  isPublished    Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

model Review {
  id            String       @id @default(uuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointmentId String       @unique
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  
  rating        Int          // 1 to 5
  comment       String
  customerName  String
  businessReply String?
  replyDate     DateTime?
  isApproved    Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

model Subscription {
  id                     String    @id @default(uuid())
  businessId             String    @unique
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planType               String    @default("TRIAL") // "TRIAL" | "PRO" | "ENTERPRISE"
  plan                   String    @default("PERSON") // "PERSON" (one person) | "TEAM" (owner + invited members)
  memberLimit            Int       @default(5)        // TEAM: member accounts allowed (owner and account-less staff not counted); admin can raise
  trialStartDate         DateTime  @default(now())
  trialEndDate           DateTime
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  status                 String    @default("trial") // "trial" | "active" | "expired" | "cancelled"
  paymentStatus          String    @default("paid")  // "paid" | "pending" | "failed"
  // Price in US dollars for one billing period (name kept from when it was a monthly TL price).
  monthlyPrice           Float     @default(1.49)
  billingPeriod          String    @default("MONTHLY") // "MONTHLY" | "YEARLY": what one payment buys
  paymentProvider        String?   @default("PayTR")
  // Bank transfer request waiting for the admin: set by the owner ("Satın al"), cleared when the admin
  // confirms or rejects it. paymentStatus is "pending" while it is open.
  paymentRequestedAt     DateTime?
  pendingAmount          Float?    // USD
  pendingAmountTry       Float?    // TL to transfer, at pendingRate
  pendingRate            Float?    // USD→TRY (TCMB selling) when the request was made
  pendingCouponCode      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String   @default("APPOINTMENT") // "APPOINTMENT" | "REVIEW" | "SUBSCRIPTION" | "SYSTEM"
  isRead     Boolean  @default(false)
  link       String?
  createdAt  DateTime @default(now())
}

model ThemeCatalog {
  id                  String   @id // e.g. "premium-dark"
  name                String
  description         String
  previewImage        String?
  supportedCategories String   // JSON array string e.g. '["BERBER", "OTO_SERVIS", "PREMIUM"]'
  isActive            Boolean  @default(true)
  isPremium           Boolean  @default(false)
  isBeta              Boolean  @default(false)
  orderIndex          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Gallery {
  id                      String        @id @default(uuid())
  businessId              String        @unique
  business                Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled                 Boolean       @default(false)
  showTitle               Boolean       @default(true)
  title                   String?       @default("Galerimiz")
  subtitle                String?       @default("Hizmetlerimizden ve çalışmalarımızdan kareler.")
  layout                  String        @default("INFINITE_FLOW") // "INFINITE_FLOW" | "DUAL_FLOW" | "CINEMATIC_STRIP" | "CARDS" | "MASONRY" | "EDITORIAL" | "FULL_BLEED"
  direction               String        @default("right-to-left") // "right-to-left" | "left-to-right"
  speed                   String        @default("NORMAL") // "VERY_SLOW" | "SLOW" | "NORMAL" | "FAST" | "VERY_FAST"
  pauseOnHover            Boolean       @default(true)
  imageSize               String        @default("MEDIUM") // "SMALL" | "MEDIUM" | "LARGE" | "XL" | "FULL"
  aspectRatio             String        @default("4:5") // "1:1" | "4:5" | "3:2" | "16:9" | "portrait" | "landscape"
  borderRadius            String        @default("rounded") // "none" | "subtle" | "rounded" | "extra"
  scrollAnimation         String        @default("Fade Up") // "None" | "Fade In" | "Fade Up" | "Fade Down" | "Slide Left" | "Slide Right" | "Scale In" | "Blur Reveal" | "Clip Reveal" | "Stagger Reveal"
  parallaxEnabled         Boolean       @default(false)
  scrollReactive          Boolean       @default(false)
  scrollDirectionTracking Boolean       @default(false)
  clickAction             String        @default("LIGHTBOX") // "NONE" | "LIGHTBOX" | "FULLSCREEN"
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  items                   GalleryItem[]
}

model GalleryItem {
  id          String   @id @default(uuid())
  galleryId   String
  gallery     Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  imageUrl    String
  title       String?
  description String?
  altText     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  id                  String   @id @default(uuid())
  key                 String   @unique // e.g. "gallerySystem"
  isEnabled           Boolean  @default(true)
  enabledSectors      String?  // JSON array string e.g. '["BERBER", "GUZELLIK", ...]' or null for all
  disabledBusinessIds String?  // JSON array string
  enabledBusinessIds  String?  // JSON array string
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model RestaurantArea {
  id          String            @id @default(uuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String            // e.g. "İç Mekan", "Teras", "Bahçe", "VIP Salon"
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tables      RestaurantTable[]

  @@index([businessId])
}

model RestaurantTable {
  id          String          @id @default(uuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  areaId      String?
  area        RestaurantArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  name        String          // e.g. "Masa 1", "Masa 2"
  capacity    Int             @default(2)
  shape       String          @default("ROUND") // "ROUND" | "SQUARE" | "RECTANGLE"
  positionX   Float           @default(100)
  positionY   Float           @default(100)
  width       Float           @default(90)
  height      Float           @default(90)
  imageUrl    String?
  description String?         // e.g. "Deniz Manzaralı", "Bahçe", "Teras", "Salon", "Pencere Kenarı"
  isActive    Boolean         @default(true)
  status      String          @default("AVAILABLE") // "AVAILABLE" | "RESERVED" | "OCCUPIED" | "OUT_OF_SERVICE"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  appointments Appointment[]

  @@index([businessId])
  @@index([areaId])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminEmail String
  adminName  String?
  action     String   // "STATUS_CHANGE" | "TRIAL_EXTEND" | "SUBSCRIPTION_CHANGE" | "FEATURE_TOGGLE" | "SECTOR_CHANGE" | "PRICE_CHANGE"
  target     String   // Business name or system target
  targetId   String?  // Business ID
  oldValue   String?
  newValue   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

model SupportTicket {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subject        String
  category       String           @default("GENERAL") // "GENERAL" | "TECHNICAL" | "BILLING" | "ACCOUNT"
  priority       String           @default("NORMAL")  // "LOW" | "NORMAL" | "HIGH" | "URGENT"
  status         String           @default("OPEN")    // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  assignedToId   String?
  assignedToName String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       SupportMessage[]

  @@index([businessId])
  @@index([status])
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole String        // "OWNER" | "SUPPORT"
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model Coupon {
  id              String             @id @default(uuid())
  code            String             @unique // stored upper-case
  percentOff      Int                // 1-100
  durationMonths  Int                @default(1) // how many monthly payments get the discount
  expiresAt       DateTime?          // last moment the code can be redeemed; null = no end date
  maxRedemptions  Int?               // total redemption limit; null = unlimited
  isActive        Boolean            @default(true)
  description     String?
  createdBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  redemptions     CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  percentOff      Int      // copied at redemption so later coupon edits don't change a running discount
  monthsRemaining Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([couponId, businessId])
  @@index([businessId])
}

// One row per signed-in mobile device. Only SHA-256 hashes of refresh tokens are stored.
model MobileSession {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String    @unique
  previousTokenHash String?   @unique // last rotated-out token: concurrent-refresh detection and reuse detection
  rotatedAt         DateTime?
  deviceName        String?
  platform          String?   // "ios" | "android"
  appVersion        String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime  // sliding 30 days, renewed on each refresh
  absoluteExpiresAt DateTime  // hard cap (90 days from sign-in)
  revokedAt         DateTime?
  revokedReason     String?   // "LOGOUT" | "REUSE" | "PASSWORD_CHANGED" | "DEACTIVATED"
  pushToken         String?   // Expo push token of this device; new-booking alerts go to the owner's live sessions

  @@index([userId])
  @@index([expiresAt])
}

// Fixed-window counters for auth rate limiting (updated atomically with an upsert).
model AuthRateLimit {
  key         String   @id // e.g. "mlogin:ip:<ip>", "mlogin:email:<sha256>"
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// TEAM plan invite, single use: a link for an existing Employee record, or a short code typed in at sign-up
// (the member's Employee record is then created on joining). Only the SHA-256 hash of the token/code is stored.
model TeamInvite {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String    @default("LINK") // "LINK" | "CODE"
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([businessId])
  @@index([employeeId])
}
