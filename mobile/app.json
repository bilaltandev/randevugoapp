{
  "expo": {
    "name": "CalendlyGo",
    "slug": "randevugo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "randevugo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.vastlab.randevugo",
      "supportsTablet": false,
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vastlab.randevugo",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CalendlyGo, galeri ve kapak görseli yüklemek için fotoğraflarınıza erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#2BBF8E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0E13",
    "extra": {
      "supportsRTL": true,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a924d2d1-c57e-4c66-87fe-b88a6859f6bf"
      }
    },
    "owner": "bilaltan01"
  }
}
